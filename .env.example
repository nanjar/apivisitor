# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - hasil sync dari MySQL corp DB)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=undangin_visitor
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Default event context (visitor app dipakai per satu events_id aktif)
DEFAULT_EVENTS_ID=26274
