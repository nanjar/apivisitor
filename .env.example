# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - hasil sync dari MySQL corp DB)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=undangin_visitor
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
# JWT_ACCESS_EXPIRES_IN sengaja TIDAK dipakai lagi — access token dibuat
# tanpa expiry (visitor gak perlu login ulang selama event). Kalau nanti
# mau balikin expiry, isi lagi expiresIn di auth.module.ts & auth.service.ts.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Default event context (visitor app dipakai per satu events_id aktif)
DEFAULT_EVENTS_ID=26274

# Ollama (LLM lokal) - server terpisah dari NestJS
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=60000

# Swagger docs - otomatis nyala kalau NODE_ENV != production.
# Di production, set 'true' cuma kalau memang mau expose docs publik.
SWAGGER_ENABLED=true

# Firebase Cloud Messaging (FCM) - buat push notification chat baru.
# Download service account JSON dari Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Taruh file-nya di server
# (JANGAN commit ke git), isi path absolutnya di sini. Kosongin kalau
# belum mau pakai push notification dulu (fitur otomatis nonaktif, gak error).
FIREBASE_SERVICE_ACCOUNT_PATH=/home/undangin/visitor_apps/visitor-api/firebase-service-account.json

# Webhook ke backend Exhibitor app - dipanggil tiap kali visitor kirim pesan
# ke PIC company, supaya sistem Exhibitor bisa notify PIC-nya sendiri.
# Kosongin kalau belum ada endpoint-nya dari tim Exhibitor (fitur otomatis
# nonaktif, gak error).
EXHIBITOR_CHAT_WEBHOOK_URL=https://exhibitor.undangin.com/api/webhooks/new-chat-message
# Secret buat sign payload (HMAC-SHA256) - tim Exhibitor pakai secret yang
# SAMA buat verifikasi header X-Webhook-Signature, biar mereka yakin request
# ini beneran dari backend ini, bukan orang lain yang nyoba nembak endpoint mereka.
EXHIBITOR_CHAT_WEBHOOK_SECRET=ganti-dengan-secret-random-disepakati-bareng-tim-exhibitor
